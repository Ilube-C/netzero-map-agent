# Copy to .env and fill in your key.

# --- Groq (free) -----------------------------------------------------------
# Get a free key at https://console.groq.com  → API Keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Other free backends (swap the two lines above) ------------------------
# Gemini : OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#          GROQ_API_KEY=<your Gemini key>  ·  GROQ_MODEL=gemini-2.0-flash
# Ollama : OPENAI_BASE_URL=http://localhost:11434/v1
#          GROQ_API_KEY=ollama  ·  GROQ_MODEL=qwen2.5

# --- PostGIS (matches docker-compose.yml) ----------------------------------
DATABASE_URL=postgresql://map:map@localhost:5432/map
