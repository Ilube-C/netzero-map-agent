# Copy to .env and fill in your key.

# --- Gemini (free) ---------------------------------------------------------
# Free key at https://aistudio.google.com/apikey — no card required.
# Free tier allows ~1500 requests/day with no daily token ceiling.
# The var is still named GROQ_API_KEY: agent.py reads one key name whatever
# the provider, so switching is only ever OPENAI_BASE_URL + GROQ_MODEL.
GROQ_API_KEY=AQ...
GROQ_MODEL=gemini-3.6-flash
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Other backends (swap the two lines above) -----------------------------
# Groq   : OPENAI_BASE_URL=https://api.groq.com/openai/v1
#          GROQ_MODEL=llama-3.3-70b-versatile
#          Free tier is only 100k tokens/day — roughly 16 turns of this app.
# Ollama : OPENAI_BASE_URL=http://localhost:11434/v1
#          GROQ_API_KEY=ollama  ·  GROQ_MODEL=qwen2.5

# --- PostGIS (matches docker-compose.yml) ----------------------------------
DATABASE_URL=postgresql://map:map@localhost:5432/map
